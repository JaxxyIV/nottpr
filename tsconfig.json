{
    "compilerOptions": {
        "module": "nodenext",
        "target": "ES2022",
        "noImplicitAny": true,
        "removeComments": false,
        "preserveConstEnums": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "allowJs": false,
        "esModuleInterop": true,
        "moduleDetection": "force",
        "moduleResolution": "nodenext",
        "allowSyntheticDefaultImports": true,
        "types": ["node"]
    },
    "include": ["src"]
}
